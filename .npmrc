# Declared engines are ENFORCED, not advisory. Without this, `engines` in
# package.json only prints a warning nobody reads, and a contributor on Node 20
# gets an obscure crash inside `globSync`/`availableParallelism` instead of a
# clear refusal at install time. CI already pins node 22 / pnpm 10, so this
# only writes down what was already true.
engine-strict=true
