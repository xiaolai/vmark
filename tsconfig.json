{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,

    /* Path alias (paths resolve relative to this tsconfig; TS 6 deprecated baseUrl) */
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    // Everything under a `__tests__` directory is test-support, not app
    // code: it may use node APIs (fs, crypto, process) that the browser
    // build has no types for. Excluding the DIRECTORY rather than only
    // `*.test.ts` covers helper modules colocated with their suites —
    // otherwise each one fails the build the first time CI reaches `tsc`.
    "src/**/__tests__/**",
    "src/test/**",
    "src/bench/**"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
