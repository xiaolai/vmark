{
  "name": "vmark",
  "private": true,
  "version": "0.9.64",
  "license": "ISC",
  "description": "The plain-text workspace where humans and AI collaborate",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "prepare": "node scripts/setup-local-git.mjs",
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "typecheck": "tsc --noEmit --incremental && tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "tauri": "node scripts/tauri-wrapper.mjs",
    "tauri:dev": "node scripts/tauri-wrapper.mjs dev --config src-tauri/tauri.dev.conf.json",
    "test": "vitest run",
    "test:changed": "node scripts/test-changed.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser:install": "playwright install webkit",
    "test:browser": "pnpm test:browser:install && vitest run --config vitest.browser.config.ts",
    "bench": "vitest bench src/bench/",
    "bench:editor": "vitest bench src/bench/editor.bench.ts",
    "bench:markdown": "vitest bench src/bench/markdown.bench.ts",
    "perf:largefile:gen": "node scripts/gen-large-file-corpus.mjs",
    "perf:largefile": "node scripts/measure-open-latency.mjs --dir tmp/large-file-corpus",
    "e2e:smoke": "node e2e/smoke.mjs",
    "e2e:journeys": "node e2e/run-journeys.mjs",
    "size": "size-limit",
    "lint:eager": "node scripts/check-eager-chunks.mjs",
    "lint:file-size": "node scripts/check-file-size.mjs",
    "lint:timer-isolation": "node scripts/check-test-timer-isolation.mjs",
    "lint:barrels": "node scripts/check-index-barrels.mjs",
    "lint:shell-slots": "node scripts/check-shell-slots.mjs",
    "lint:bespoke-buttons": "node scripts/check-bespoke-buttons.mjs",
    "check:cross": "bash scripts/check-cross-target.sh",
    "size:why": "size-limit --why",
    "lint": "eslint src --cache --cache-strategy content --cache-location .eslintcache",
    "lint:ui-consistency": "node scripts/check-ui-consistency.mjs",
    "lint:design-tokens": "node scripts/check-design-tokens.mjs",
    "lint:emdash": "node scripts/check-emdash-spacing.mjs",
    "lint:cjk-demo-parity": "node scripts/check-cjk-demo-parity.mjs",
    "lint:test-types": "node scripts/check-test-types.mjs",
    "lint:no-nul-bytes": "node scripts/check-no-nul-bytes.mjs",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs --ignore-known",
    "arch:graph": "node scripts/arch-graph.mjs",
    "arch:metrics": "node scripts/arch-metrics.mjs",
    "lint:tauri-versions": "node scripts/check-tauri-versions.mjs",
    "lint:webview-floor": "node scripts/check-webview-floor.mjs",
    "lint:window-thread": "node scripts/check-window-creation-thread.mjs",
    "lint:console": "bash scripts/lint-console.sh",
    "lint:i18n": "tsx scripts/check-i18n-keys.ts",
    "lint:themes": "bash scripts/check-theme-names.sh",
    "lint:theme-contrast": "node --import tsx scripts/check-theme-contrast.ts",
    "lint:keybinding-manifest": "node scripts/check-keybinding-manifest.mjs",
    "extract-menu-ids": "tsx scripts/extract-menu-ids.ts",
    "knip": "knip",
    "knip:files": "knip --include files,dependencies",
    "dup": "jscpd",
    "mutation:ts": "stryker run",
    "test:sidecar": "pnpm --dir server/mcp lint && pnpm --dir server/mcp build && pnpm --dir server/mcp test:coverage",
    "test:content-server": "pnpm --dir server/content build && pnpm --dir server/content smoke && pnpm --dir server/content test:coverage",
    "check:static": "pnpm lint && pnpm lint:console && pnpm lint:ui-consistency && pnpm lint:design-tokens && pnpm lint:emdash && pnpm lint:cjk-demo-parity && pnpm lint:no-nul-bytes && pnpm lint:deps && pnpm lint:hooks-purity && pnpm lint:extension-budget && pnpm lint:store-coupling && pnpm lint:mock-boundaries && pnpm lint:command-errors && pnpm lint:ipc-contract && pnpm lint:trusted-html && pnpm lint:type-aware && pnpm lint:test-types && pnpm lint:mutants-config && pnpm lint:deleted-names && pnpm lint:mcp-contracts && pnpm lint:mcp-docs && pnpm lint:tauri-versions && pnpm lint:webview-floor && pnpm lint:window-thread && pnpm lint:i18n && pnpm lint:themes && pnpm lint:theme-contrast && pnpm lint:keybinding-manifest && pnpm lint:merge-drops && pnpm lint:file-size && pnpm lint:timer-isolation && pnpm lint:barrels && pnpm lint:shell-slots && pnpm lint:bespoke-buttons && pnpm knip && pnpm lint:knip-baseline && pnpm lint:review-schedule && pnpm test:gates",
    "check:servers": "pnpm test:sidecar && pnpm test:content-server",
    "check:build": "pnpm build && pnpm lint:eager && pnpm size",
    "check:all": "pnpm check:static && pnpm test:coverage && pnpm check:servers && pnpm check:build",
    "check:fast": "pnpm typecheck && pnpm lint && pnpm test:changed",
    "check:predelta": "node scripts/check-predelta.mjs",
    "lint:extension-budget": "node scripts/check-extension-budget.mjs",
    "lint:knip-baseline": "node scripts/check-knip-baseline.mjs",
    "lint:store-coupling": "node scripts/check-plugin-store-coupling.mjs",
    "lint:mock-boundaries": "node scripts/check-mock-boundaries.mjs",
    "lint:command-errors": "node scripts/check-command-error-ratchet.mjs",
    "lint:mutants-config": "node scripts/check-mutants-config-path.mjs",
    "lint:deleted-names": "node scripts/check-deleted-names.mjs",
    "lint:merge-drops": "node scripts/check-merge-drops.mjs",
    "lint:hooks-purity": "node scripts/check-hooks-react-purity.mjs",
    "gen:mcp-contracts": "tsx server/mcp/scripts/gen-mcp-contracts.ts",
    "lint:mcp-contracts": "tsx server/mcp/scripts/gen-mcp-contracts.ts --check",
    "lint:mcp-docs": "node scripts/check-mcp-docs.mjs",
    "test:gates": "vitest run --config vitest.gates.config.ts",
    "test:soak": "vitest run --config vitest.soak.config.ts",
    "e2e:ime": "node e2e/run-ime.mjs",
    "clean:dev": "bash scripts/clean-dev.sh",
    "lint:review-schedule": "node scripts/check-review-schedule.mjs",
    "lint:ipc-contract": "node scripts/check-ipc-contract.mjs",
    "lint:trusted-html": "node scripts/check-trusted-html-contract.mjs",
    "lint:type-aware": "node scripts/check-type-aware.mjs",
    "lint:rust-deps": "cargo machete src-tauri"
  },
