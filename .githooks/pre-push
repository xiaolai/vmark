#!/usr/bin/env bash
#
# pre-push — gate pushes that update `main` or a release tag (`v*`).
# Feature-branch pushes are NOT gated here — CI gates those through the
# PR's required `frontend` check.
#
# WHAT RUNS (reworked under WI-7, 2026-08-03 — §9: fixing the gate, not
# bypassing it; the check moved from proxy (re-running the suite locally)
# to property (CI's recorded verdict on the exact SHA)):
#
#   Tag leg (refs/tags/v*) — the real gate. Branch protection cannot gate
#   tag pushes, so before a `v*` tag leaves this machine the hook runs
#   `scripts/check-tag-green.sh <tagged commit>`: a `gh api …/check-runs`
#   verification that the required checks (`frontend`, `rust` — the same
#   two `main` requires) are `completed`+`success` on the exact commit the
#   tag names. Pending, failed, or missing checks refuse the push; so does
#   an unreachable `gh` (network down, not authed) — that script fails
#   closed, never silently passes, and points at VMARK_OFFLINE_GATE=1.
#
#   Main leg (refs/heads/main) — informational only. Branch protection
#   (required checks `frontend`+`rust`, `enforce_admins: true`, PR required;
#   enabled 2026-07-27 — see .claude/rules/60-ai-governance.md §10) makes
#   the REMOTE reject any direct push of a commit its required checks have
#   not passed. The remote is authoritative; a local API re-check here would
#   duplicate it and spuriously block the legitimate case (a fresh merge
#   commit whose own `on: push` runs have not started yet — its checks ran
#   on the PR head, not the merge SHA).
#
#   VMARK_OFFLINE_GATE=1 — runs the full legacy local gate instead, for
#   both legs: cross-target compile check (scripts/check-cross-target.sh),
#   `cargo fmt --check`, `cargo clippy --all-targets -- -D warnings`, and
#   `pnpm check:all`. Use it when gh/network is unavailable, or when you
#   want the local proxy anyway.
#
# KNOWN LIMITATION — the check/push residual window (accepted, not fixed).
#
#   This is a time-of-check/time-of-use gap, and it is inherent to gating a
#   push from the client. The hook asks the API for CI's verdict on the tagged
#   commit; git then uploads the pack and the remote updates `refs/tags/v*`.
#   Nothing binds the two: the verdict is read BEFORE the ref update lands, so
#   a verdict that changes in between is not seen, and the remote does not
#   re-verify anything when it accepts a tag (branch protection does not cover
#   tag refs — the reason this hook exists at all).
#
#   Why it is accepted rather than closed. Closing it properly means moving the
#   gate server-side: `.github/workflows/release.yml` (`on: push` of `v*`) would
#   re-query the required check-runs for the tagged SHA and refuse to build or
#   publish when they are not green. That is a re-architecture of the release
#   pipeline, deliberately out of scope for this hook, and it is the honest
#   place for the check because only the remote can be authoritative about a
#   ref it has already accepted.
#
#   What bounds it in practice:
#     - Duration: the gap is the pack upload — seconds, not a review cycle.
#     - Trigger: a completed check-run's conclusion changes only when someone
#       manually re-runs the job on that exact commit. Racing a release push is
#       not an accident; it is a deliberate act by someone with write access.
#     - Blast radius: pushing the tag is not the publish. The release workflow
#       still has to build and upload, a bad tag can be deleted (and the draft
#       release with it) while that runs, and the red check-run stays visible on
#       the commit for anyone auditing afterwards.
#   So the residual window is documented here rather than papered over — the
#   same posture as the other residual controls in
#   .claude/rules/60-ai-governance.md §10.
#
# TIMING (authoritative claim — other docs reference this header instead of
# restating numbers):
#   - Default tag leg: seconds — one `gh api` call per pushed tag.
#   - Full legacy gate (VMARK_OFFLINE_GATE=1): roughly 6–10+ minutes on a
#     warm dev machine (cross-compile + rustfmt + clippy + `pnpm check:all`).
#
# Why this hook exists: `v*` tags (and, before branch protection, `main`)
# can be pushed directly, bypassing the PR-based CI gate — the commit is
# already on the branch by the time `on: push` CI runs, so a red gate can't
# be un-landed. That is exactly how the content-server merge (e2a0dffe)
# reached main red. The offline gate keeps the cross-target, rustfmt, and
# clippy legs because each caught a real landed-red class: cfg(target_os)
# breakage 4× on the v0.8.26 release push, a clippy `-D warnings` violation
# (#1113 triage), and a whole-module rustfmt drift — none of which
# `pnpm check:all` (frontend-only) can see.
#
# Bypassing this hook (`git push --no-verify`) is forbidden without explicit
# authorization — see .claude/rules/60-ai-governance.md §9.
#
# Enabled via `git config core.hooksPath .githooks`, set by the root
# package.json `prepare` script (scripts/setup-local-git.mjs) on
# `pnpm install`.
#
# That same setup also adds an SSH keepalive to `core.sshCommand`. The
# offline gate runs for minutes (see TIMING above) while git holds the SSH
# connection to the remote open; without a keepalive the idle connection
# times out and the subsequent pack upload dies with SIGPIPE (exit 141) —
# the gate passes but the push never lands. If a direct push to `main`/`v*`
# ever fails that way, run `node scripts/setup-local-git.mjs` (or push once
# with `GIT_SSH_COMMAND='ssh -o ServerAliveInterval=20' git push …`).

set -euo pipefail

z40="0000000000000000000000000000000000000000"
push_main=0
tag_list=""

# git feeds "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  [ "$local_sha" = "$z40" ] && continue   # branch/tag deletion — nothing to verify
  case "$remote_ref" in
    refs/heads/main) push_main=1 ;;
    refs/tags/v*)
      # Annotated tags: local_sha names the tag OBJECT — resolve to the commit.
      commit_sha=$(git rev-parse "${local_sha}^{commit}")
      tag_list="${tag_list}${remote_ref} ${commit_sha}"$'\n'
      ;;
  esac
done

if [ "$push_main" -eq 0 ] && [ -z "$tag_list" ]; then
  exit 0
fi

run_full_local_gate() {
  # Cross-target compile check first: it fails in seconds on the class of
  # bug the host-only gate can't see (cfg(target_os) imports/dead-code that
  # only break on Windows/Linux — the v0.8.26 release push hit this 4× in a
  # row). Soft-skips with a warning if the mingw toolchain isn't installed;
  # see scripts/check-cross-target.sh for setup.
  echo "pre-push (offline gate): cross-target compile check…"
  if ! bash scripts/check-cross-target.sh; then
    cat >&2 <<'MSG'

✖ pre-push blocked: cross-target compile check failed.
  This code will not compile on Windows CI. Fix before pushing main/v*.
  Overriding (`git push --no-verify`) requires explicit authorization —
  see .claude/rules/60-ai-governance.md §9.
MSG
    exit 1
  fi

  # rustfmt gate: `pnpm check:all` never runs cargo fmt, so a formatting
  # drift in src-tauri (the whole browser/ module drifted under a rustfmt
  # stable bump) rides straight onto main and only trips CI's Linux-only
  # Format check. Run the exact CI command here so main stays fmt-clean.
  echo "pre-push (offline gate): cargo fmt --check…"
  if ! cargo fmt --manifest-path src-tauri/Cargo.toml --check; then
    cat >&2 <<'MSG'

✖ pre-push blocked: cargo fmt --check found unformatted Rust.
  Run `cargo fmt --manifest-path src-tauri/Cargo.toml` and re-commit.
  Overriding (`git push --no-verify`) requires explicit authorization —
  see .claude/rules/60-ai-governance.md §9.
MSG
    exit 1
  fi

  # Clippy gate: `pnpm check:all` is frontend-only — it never runs cargo
  # clippy, so a `-D warnings` violation in src-tauri can (and did, #1113
  # triage) land on main red. This is the exact command CI's rust-test job
  # runs; main must be clippy-clean.
  echo "pre-push (offline gate): cargo clippy (warnings as errors)…"
  if ! cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings; then
    cat >&2 <<'MSG'

✖ pre-push blocked: cargo clippy reported warnings (treated as errors).
  This is the exact check CI's rust-test job runs; main must be clippy-clean.
  Overriding (`git push --no-verify`) requires explicit authorization —
  see .claude/rules/60-ai-governance.md §9.
MSG
    exit 1
  fi

  echo "pre-push (offline gate): running the full quality gate (pnpm check:all)…"
  if ! pnpm check:all; then
    cat >&2 <<'MSG'

✖ pre-push blocked: `pnpm check:all` failed.
  main and release tags must be green before they leave this machine.
  Fix the gate first. Overriding (`git push --no-verify`) requires explicit
  authorization — see .claude/rules/60-ai-governance.md §9.
MSG
    exit 1
  fi

  echo "✔ pre-push: offline quality gate green — push allowed."
}

if [ "${VMARK_OFFLINE_GATE:-0}" = "1" ]; then
  run_full_local_gate
  exit 0
fi

# Tag leg: verify CI's verdict on the exact tagged commit (seconds).
if [ -n "$tag_list" ]; then
  while IFS=' ' read -r ref sha; do
    [ -z "$ref" ] && continue
    echo "pre-push: verifying required CI checks on ${ref#refs/tags/} (${sha})…"
    if ! bash scripts/check-tag-green.sh "$sha"; then
      cat >&2 <<'MSG'

✖ pre-push blocked: the tagged commit is not verified green by CI.
  A release tag must name a commit whose required checks (frontend, rust)
  completed successfully. If CI is still running, wait and push the tag
  again. If gh/network is unavailable, run the full local gate instead:
    VMARK_OFFLINE_GATE=1 git push …
  Overriding (`git push --no-verify`) requires explicit authorization —
  see .claude/rules/60-ai-governance.md §9.
MSG
      exit 1
    fi
  done <<EOF
$tag_list
EOF
fi

# Main leg: branch protection on the remote is authoritative (see header).
if [ "$push_main" -eq 1 ]; then
  echo "pre-push: pushing main — no local re-check; branch protection on the"
  echo "          remote is authoritative (required checks frontend+rust,"
  echo "          enforce_admins — .claude/rules/60-ai-governance.md §10)."
  echo "          To run the full local gate anyway: VMARK_OFFLINE_GATE=1 git push …"
fi

exit 0
