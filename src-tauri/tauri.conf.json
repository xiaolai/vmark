{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VMark",
  "version": "0.9.94",
  "identifier": "app.vmark",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "VMark",
        "label": "main",
        "width": 800,
        "height": 600,
        "minWidth": 480,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 19, "y": 28 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; img-src 'self' asset: https://asset.localhost blob: data: https: http:; style-src 'self' 'unsafe-inline'; frame-src 'self' vmark-trusted: http://vmark-trusted.localhost https://www.youtube-nocookie.com https://player.vimeo.com https://player.bilibili.com; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "/Volumes/**", "/mnt/**", "/media/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "shortDescription": "Plain-text workspace for humans and AI",
    "longDescription": "VMark is the plain-text workspace where humans and AI collaborate. Both parties read and write the same artifacts — markdown, YAML, JSON, TOML, Mermaid, SVG, HTML, code — directly. Schema-aware previews render the right view for known artifacts (GitHub Actions workflows, Cargo.toml, package.json, pyproject.toml).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mdx"],
        "mimeType": "text/markdown",
        "description": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": ["txt"],
        "mimeType": "text/plain",
        "description": "Plain Text Document",
        "role": "Editor"
      },
      {
        "ext": ["json", "jsonl"],
        "mimeType": "application/json",
        "description": "JSON Document",
        "role": "Editor"
      },
      {
        "ext": ["yaml", "yml"],
        "mimeType": "text/yaml",
        "description": "YAML Document",
        "role": "Editor"
      },
      {
        "ext": ["toml"],
        "mimeType": "text/x-toml",
        "description": "TOML Document",
        "role": "Editor"
      },
      {
        "ext": ["mmd"],
        "mimeType": "text/x-mermaid",
        "description": "Mermaid Diagram",
        "role": "Editor"
      },
      {
        "ext": ["svg"],
        "mimeType": "image/svg+xml",
        "description": "SVG Image",
        "role": "Editor"
      },
      {
        "ext": ["html", "htm"],
        "mimeType": "text/html",
        "description": "HTML Document",
        "role": "Editor"
      }
    ],
    "externalBin": [
      "binaries/vmark-mcp-server"
    ],
    "resources": [
      "resources/workflows/**/*",
      "resources/generated/THIRD_PARTY_LICENSES.txt"
    ],
    "macOS": {
      "entitlements": "app-entitlements.plist",
      "minimumSystemVersion": "13.4",
      "files": {
        "Resources/Assets.car": "icons/Assets.car",
        "Resources/en.lproj/InfoPlist.strings": "macos-l10n/en.lproj/InfoPlist.strings",
        "Resources/de.lproj/InfoPlist.strings": "macos-l10n/de.lproj/InfoPlist.strings",
        "Resources/es.lproj/InfoPlist.strings": "macos-l10n/es.lproj/InfoPlist.strings",
        "Resources/fr.lproj/InfoPlist.strings": "macos-l10n/fr.lproj/InfoPlist.strings",
        "Resources/it.lproj/InfoPlist.strings": "macos-l10n/it.lproj/InfoPlist.strings",
        "Resources/ja.lproj/InfoPlist.strings": "macos-l10n/ja.lproj/InfoPlist.strings",
        "Resources/ko.lproj/InfoPlist.strings": "macos-l10n/ko.lproj/InfoPlist.strings",
        "Resources/pt-BR.lproj/InfoPlist.strings": "macos-l10n/pt-BR.lproj/InfoPlist.strings",
        "Resources/zh-Hans.lproj/InfoPlist.strings": "macos-l10n/zh-Hans.lproj/InfoPlist.strings",
        "Resources/zh-Hant.lproj/InfoPlist.strings": "macos-l10n/zh-Hant.lproj/InfoPlist.strings"
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFQ0NGRjU5RUZBM0RBMDIKUldRQzJxUHZXZi9NL2k3RU9JbGg5amYxS2FVVFNGU0hTUWdEbUppcHpxTTRQMThkOVlKL0F3MUcK",
      "endpoints": [
        "https://log.vmark.app/update/latest.json?target={{target}}&arch={{arch}}&version={{current_version}}",
        "https://github.com/xiaolai/vmark/releases/latest/download/latest.json"
      ]
    }
  }
}
